{
  "name": "tokenalysis",
  "version": "0.1.0",
  "description": "Local LLM proxy that records per-request token usage (input/output/cache read/cache write), tool and MCP attribution, and dollar cost, with a built-in dashboard.",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "author": "Philificent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Philificent/tokenalysis.git"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "chart.js": "^4.5.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true
  }
}
